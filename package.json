{
  "name": "availogger-pages",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "npm --prefix frontend run build",
    "dev": "wrangler pages dev frontend/dist --config wrangler.local.jsonc",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --config wrangler.local.jsonc",
    "db:status:local": "wrangler d1 migrations list DB --local --config wrangler.local.jsonc",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "functions:build": "wrangler pages functions build functions --outdir .wrangler/pages-build"
  },
  "dependencies": {
    "jose": "^6.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260925.2",
    "@types/node": "^22.20.4",
    "miniflare": "^5.20260925.0-alpha",
    "typescript": "^5.9.0",
    "vitest": "^5.0.2",
    "wrangler": "^4.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260925.1": true
  }
}

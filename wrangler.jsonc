{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "availogger",
  "pages_build_output_dir": "./frontend/dist",
  "compatibility_date": "2026-09-01",
  // Deployment gate: apply the D1 migration and configure the encryption secret
  // before merging. See docs/per-user-flightlogger.md.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "studentportal-db",
      "database_id": "a6a29063-bacf-454f-8423-5e956e769e5f",
      "migrations_dir": "./migrations"
    }
  ],
  // Previews must not inherit production user/credential storage.
  // Add a separately provisioned DB here only when preview testing is needed.
  "env": { "preview": { "d1_databases": [], "kv_namespaces": [] } },
  "kv_namespaces": [
    { "binding": "AVAILABILITY_CACHE", "id": "ccce02514a2b44d2a7698529136751fd" }
  ]
}

{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "availogger-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "secrets": {
    "required": ["FLIGHTLOGGER_API_TOKEN"]
  },
  "kv_namespaces": [
    { "binding": "AVAILABILITY_CACHE", "id": "ccce02514a2b44d2a7698529136751fd" }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://1ntray.github.io,http://localhost:5173,https://availogger.pages.dev"
  }
}

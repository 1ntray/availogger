{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "availogger",
  "pages_build_output_dir": "./frontend/dist",
  "compatibility_date": "2026-09-01",
  // GitHub releases validate/build, migrate this target, then deploy Pages.
  // See docs/database-updates.md for bootstrap and environment setup.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "studentportal-db",
      "database_id": "a6a29063-bacf-454f-8423-5e956e769e5f",
      "migrations_dir": "./migrations"
    }
  ],
  // Previews must not inherit production user/credential storage.
  // Preview storage is separate; runtime secrets/Access are set in Pages.
  "env": {
    "preview": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "studentportal-preview",
          "database_id": "29d8b17d-c2e1-4b2d-bc17-4c295bd049af",
          "migrations_dir": "./migrations"
        }
      ],
      "kv_namespaces": [
        { "binding": "AVAILABILITY_CACHE", "id": "adf2fbe2e1314246a8e6d973fc4994ae" }
      ]
    }
  },
  "kv_namespaces": [
    { "binding": "AVAILABILITY_CACHE", "id": "ccce02514a2b44d2a7698529136751fd" }
  ]
}

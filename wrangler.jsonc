{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "availogger",
  "pages_build_output_dir": "./frontend/dist",
  "compatibility_date": "2026-09-01",
  // Apply migrations to the target DB before activating new Functions.
  // See docs/duty-ops.md for preview setup and release verification.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "studentportal-db",
      "database_id": "a6a29063-bacf-454f-8423-5e956e769e5f",
      "migrations_dir": "./migrations"
    }
  ],
  // Previews must not inherit production user/credential storage.
  // The preview DB is separate; preview KV/secrets/Access still need setup.
  "env": {
    "preview": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "studentportal-preview",
          "database_id": "29d8b17d-c2e1-4b2d-bc17-4c295bd049af",
          "migrations_dir": "./migrations"
        }
      ],
      "kv_namespaces": []
    }
  },
  "kv_namespaces": [
    { "binding": "AVAILABILITY_CACHE", "id": "ccce02514a2b44d2a7698529136751fd" }
  ]
}
